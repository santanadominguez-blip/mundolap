<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mx.mundolap</groupId>
    <artifactId>mundolap</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>Mundo Lap - Punto de venta y servicios de reparación</name>

    <properties>
        <!-- Versión mínima de Java. Compila y corre con JDK 17 o cualquier versión posterior (21, 25...). -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Clase principal: NetBeans la usa al presionar "Run" -->
        <exec.mainClass>mx.mundolap.App</exec.mainClass>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <!-- Driver JDBC de PostgreSQL (conexión con la base de datos de pgAdmin) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- 42.7.7 o posterior: las versiones 42.7.4 a 42.7.6 tienen la vulnerabilidad CVE-2025-49146 -->
            <version>42.7.7</version>
        </dependency>

        <!-- Pruebas automatizadas (solo se usan al ejecutar "Test"; no viajan con el sistema) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
